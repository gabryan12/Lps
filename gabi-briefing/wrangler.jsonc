{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gabi-briefing",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "sagatrafego@gmail.com"
    }
  ],
  "routes": [
    { "pattern": "gabrieldiniztrafego.com.br", "custom_domain": true },
    { "pattern": "www.gabrieldiniztrafego.com.br", "custom_domain": true }
  ]
}
