{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gabi-briefing",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/forms/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "sagatrafego@gmail.com"
    }
  ],
  // O id é criado sozinho no primeiro "wrangler deploy". Para criar à mão, veja o README.
  "kv_namespaces": [{ "binding": "BRIEFINGS" }],
  // Só /forms e /forms/*: a raiz do domínio continua livre para o site da agência.
  "routes": [
    { "pattern": "gabrieldiniztrafego.com.br/forms", "zone_name": "gabrieldiniztrafego.com.br" },
    { "pattern": "gabrieldiniztrafego.com.br/forms/*", "zone_name": "gabrieldiniztrafego.com.br" },
    { "pattern": "www.gabrieldiniztrafego.com.br/forms", "zone_name": "gabrieldiniztrafego.com.br" },
    { "pattern": "www.gabrieldiniztrafego.com.br/forms/*", "zone_name": "gabrieldiniztrafego.com.br" }
  ]
}
